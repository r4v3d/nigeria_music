# Copia este archivo a .env en el VPS (NO lo subas a GitHub)

TELEGRAM_BOT_TOKEN=123456:ABC-DEF_tu_token_de_BotFather
# Tu user id numérico (en el bot: /whoami). Varios: 111,222
TELEGRAM_ALLOWED_IDS=123456789

# Chrome visible (0). En Contabo el service usa xvfb-run.
# Solo fuerza headless puro con: TELEGRAM_FORCE_HEADLESS=1
TIDAL_HEADLESS=0

# Cada cuántas líneas de log se envían a Telegram
TELEGRAM_LOG_EVERY=8

# Máximo de Chromes en paralelo (oleadas); Contabo pequeño: 3
TIDAL_MAX_PARALLEL=5
